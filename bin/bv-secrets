#!/bin/sh
# Shim CLI : ajoute la racine du projet au PYTHONPATH puis lance le module.
# bootstrap.sh installe ce fichier par un lien symbolique : deref avant de
# remonter, sinon la racine devient celle du lien (~/.local) et l'import echoue.
self=$(readlink -f -- "$0" 2>/dev/null) || self=$0
[ -n "$self" ] || self=$0
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
exec env PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" python3 -m bvsecrets.cli "$@"
