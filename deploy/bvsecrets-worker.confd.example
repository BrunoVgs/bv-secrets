# Configuration propre au site pour le worker bv-secrets.
# OpenRC source ce fichier avant le script d'init.
#
#     doas cp deploy/bvsecrets-worker.confd.example /etc/conf.d/bvsecrets-worker
#     doas rc-service bvsecrets-worker restart
#
# Le dépôt reste générique : les noms de services réels vivent ici, pas dans le code.

# Racine du projet, si elle diffère de l'emplacement d'installation par défaut
#BV_SECRETS_ROOT="/srv/containers/bv-secrets"

# Emplacement du store (valeurs, rendus, spool, miroir chiffré)
#BV_SECRETS_DIR="/opt/bv-secrets"

# Racine docker compose. Par défaut : le dossier parent du projet.
#BV_COMPOSE_DIR="/srv/containers"

# Reverse-proxy consommant la matrice d'accès. Recréé (et non redémarré) après un
# changement : sa config est montée fichier par fichier.
BV_PROXY_SERVICE="caddy"

# Services à redémarrer après un changement d'accès, séparés par des virgules.
BV_ACCESS_RELOAD_SERVICES=""

# Service portant la console de gestion des comptes. Laissé vide, la vue Comptes
# du dashboard est désactivée.
BV_AUTH_SERVICE=""
