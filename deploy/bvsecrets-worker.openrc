#!/sbin/openrc-run
# Worker bv-secrets — seul composant privilégié du système.
# Tourne en `bv` (docker + store rw), sans réseau entrant. Il vide le spool
# alimenté par l'UI web read-only et exécute rotate/apply/doctor.
#
# Install :  doas cp /home/bv/containers/bv-secrets/deploy/bvsecrets-worker.openrc \
#                    /etc/init.d/bvsecrets-worker
#            doas chmod +x /etc/init.d/bvsecrets-worker
#            doas rc-update add bvsecrets-worker default
#            doas rc-service bvsecrets-worker start

name="bvsecrets-worker"
description="bv-secrets spool worker (rotate/apply executor)"

: ${BV_SECRETS_ROOT:=/home/bv/containers/bv-secrets}

command="/usr/bin/python3"
command_args="-u -m bvsecrets.worker.loop"
command_user="bv:bv"
command_background="yes"
directory="${BV_SECRETS_ROOT}"
pidfile="/run/bvsecrets-worker.pid"
output_log="/var/log/bvsecrets-worker.log"
error_log="/var/log/bvsecrets-worker.log"

# OpenRC source /etc/conf.d/bvsecrets-worker, mais une affectation shell n'entre
# pas dans l'environnement du démon : les variables du site doivent être exportées
# explicitement. Vides, elles retombent sur les défauts côté Python.
export PYTHONPATH="${BV_SECRETS_ROOT}"
export BV_SECRETS_DIR BV_SECRETS_CONF BV_COMPOSE_DIR
export BV_PROXY_SERVICE BV_ACCESS_RELOAD_SERVICES BV_AUTH_SERVICE

depend() {
	need docker
	after net
}

start_pre() {
	checkpath -d -m 0700 -o bv:bv /opt/bv-secrets/spool
	checkpath -f -m 0644 -o bv:bv /var/log/bvsecrets-worker.log
}
