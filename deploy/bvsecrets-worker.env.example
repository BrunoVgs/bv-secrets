# Site config for the bv-secrets worker: KEY=VALUE, read by the generated unit.
# Copy it where your init system expects it, as root:
#
#     systemd   /etc/default/bvsecrets-worker   then systemctl restart bvsecrets-worker
#     OpenRC    /etc/conf.d/bvsecrets-worker    then rc-service bvsecrets-worker restart
#
# The repo stays generic: real names and conventions live here, not in the code.

# Store (values, renders, spool, encrypted mirror).
#BV_SECRETS_DIR="/opt/bv-secrets"

# Docker compose root. Default: the project's parent directory.
#BV_COMPOSE_DIR="/srv/containers"

# --- Proxy & access ---------------------------------------------------------
# Reverse proxy that consumes the access matrix, recreated (not restarted) after a
# change since its config is mounted file by file.
BV_PROXY_SERVICE="caddy"
# Services to restart after an access change, comma-separated.
BV_ACCESS_RELOAD_SERVICES=""
# Renderer that turns the matrix into your proxy's config. Any executable
# implementing `set <svc> <roles>` and `all`. Default: <compose>/access/render-access.py
#BV_ACCESS_RENDER="/srv/containers/access/render-access.py"
# Container name for reading the access log in audit. Default: BV_PROXY_SERVICE or "caddy".
#BV_CADDY_CONTAINER="caddy"

# --- Roles ------------------------------------------------------------------
# Strongest to weakest; the first is the superuser that passes every gate.
#BV_ROLES="admin,trusted,guest"

# --- Accounts ---------------------------------------------------------------
# Service hosting the account CLI. Empty: the Accounts view is disabled.
BV_AUTH_SERVICE=""
# Console prefix and subcommands. Defaults are Symfony's; override for any framework.
#BV_AUTH_CONSOLE="php bin/console"
#BV_AUTH_CMD_LIST="app:users"
#BV_AUTH_CMD_SETROLE="app:set-role"
#BV_AUTH_CMD_DELETE="app:delete-user"

# --- Audit ------------------------------------------------------------------
# Access-log path prefixes to drop from the timeline (internal polling, health checks).
#BV_AUDIT_IGNORE_PATHS="/api/,/health"
# Host log for SSH logins and elevations. Auto by default: /var/log/messages,
# auth.log, secure, then journalctl. Set a path, or `journal`, to force one.
#BV_HOST_SYSLOG="journal"
