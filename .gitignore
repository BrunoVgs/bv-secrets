# The real config describes the infrastructure: services, SQL users, paths, probe
# commands. No secret value, but a full map of the estate. Only
# secrets.conf.example is versioned.
secrets.conf

# Project config: real service names, paths, roles. Only bv-secrets.ini.example
# is versioned.
bv-secrets.ini

# The store, renders and encrypted mirror live outside the project ($BV_SECRETS_DIR)
# and must never enter it.
*.env
*.env.local
store.enc
.masterkey
rendered/
spool/

__pycache__/
*.py[cod]
.venv/
*.bak
*.bak.*

# Packaging artifacts
build/
dist/
*.egg-info/

# Worker site config: real deployment service names.
deploy/bvsecrets-worker.confd
