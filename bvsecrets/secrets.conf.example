# =============================================================================
# bv-secrets -- SOURCE DECLARATIVE (structure uniquement, AUCUNE valeur secrete).
# Versionnable. Les valeurs vivent dans le store, jamais ici.
#
# Deux axes independants :
#   kind   ce que la valeur EST      password|hex|b64|userpass|passphrase|apikey|opaque|computed
#   group  QUAND on la regenere      auto (rotate nu) | autre (seulement si ciblee) | manual (jamais)
#
# Un sink dit ou pousser la valeur :  schema:cible#selecteur
#   env:pihole#FTLCONF_...      variable du .env d'un service compose
#   envfile:/chemin/.env#CLE    fichier adopte, ecrit en place, ligne par ligne
#   file:/chemin                fichier dedie
#   cmd:...                     commande, {value} interpole
#
# Les gabarits `x-` se reprennent avec `<<: *nom` ; ce qui est pose en propre
# dans un secret gagne sur le gabarit.
# =============================================================================

secrets:

  APP_ADMIN_PASSWORD:
    kind: password
    group: auto
    length: 24
    note: compte admin de l'application
    sinks:
      - env:webapp#ADMIN_PASSWORD

  APP_ADMIN_USER:
    kind: opaque
    group: manual
    note: "identifiant, pas un secret : opaque = jamais généré"
    sinks:
      - env:dashboard#ADMIN_USER

  APP_DATABASE_URL:
    kind: computed
    group: manual
    compute: raw mysql://appuser:{DB_APP_PASSWORD}@database:3306/appdb
    note: suit automatiquement DB_APP_PASSWORD
    sinks:
      - env:webapp#DATABASE_URL

  DB_APP_PASSWORD:
    kind: password
    group: auto
    length: 24
    note: "norestart : la base ne lit cette variable qu'à l'initialisation ;\nle mot de passe réel est posé par le sink mysql:"
    sinks:
      - mysql:appuser@database
      - env:database#MARIADB_PASSWORD
    norestart:
      - database

  DB_ROOT_PASSWORD:
    kind: password
    group: careful
    length: 32
    note: "careful : roté uniquement s'il est explicitement ciblé"
    sinks:
      - mysql:root@database
      - env:database#MARIADB_ROOT_PASSWORD
    norestart:
      - database

  FILES_PASSWORD:
    kind: password
    group: auto
    length: 20
    probe: docker exec proxy wget -qO/dev/null --post-data='{"username":"admin","password":"{value}"}' http://files:80/api/login
    note: le sink cmd applique la valeur dans l'app, la probe confirme qu'elle marche
    sinks:
      - env:dashboard#FILES_PASSWORD
      - "cmd: docker compose run --rm files users update admin --password '{value}'"

  GRAFANA_ADMIN_PASSWORD:
    kind: password
    group: app
    note: "ini : atteint une clé de section sans toucher au reste du fichier"
    sinks:
      - ini:/srv/grafana/grafana.ini#security.admin_password

  MEDIA_API_KEY:
    kind: apikey
    group: manual
    # refuse une clé collée de travers des `set`
    validate: prefix:mk_
    note: régénérer dans l'application, puis `set`
    sinks:
      - env:dashboard#MEDIA_KEY

  SIGNING_KEY:
    kind: hex
    group: app
    length: 64
    note: "app : roté seulement s'il est ciblé"
    sinks:
      - file:/etc/myapp/signing.key:0600

  THIRDPARTY_ADMIN_PASSWORD:
    kind: password
    group: app
    note: valeur préexistante adoptée via `import`
    sinks:
      - envfile:/srv/thirdparty/.env#ADMIN_PASSWORD
