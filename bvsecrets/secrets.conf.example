# bv-secrets — déclaration des secrets. Structure uniquement, AUCUNE valeur.
# Les valeurs vivent dans $BV_SECRETS_DIR/bv-secrets.env (0600, hors du dépôt).
#
# Copier ce fichier en secrets.conf et l'adapter :
#     cp secrets.conf.example secrets.conf
#
# Deux axes orthogonaux, à ne pas remélanger :
#   kind  = FORMAT de la valeur     password | hex | b64 | passphrase | userpass
#                                   | opaque | computed | apikey
#   group = POLITIQUE de rotation   auto | app | careful | manual
#
# Sinks / localisations — où la valeur vit. Les schémas bidirectionnels (lit+écrit)
# permettent d'ADOPTER une valeur déjà en place (`import`) et de détecter les
# dérives (`status`) :
#   envfile:/chemin#<CLE>    une clé dans un fichier KEY=VALUE        (lit + écrit)
#   json:/chemin#<a.b.c>     une valeur à un chemin JSON              (lit + écrit)
#   yaml:/chemin#<a.b.c>     un scalaire à un chemin YAML             (lit + écrit)
#   ini:/chemin#<sect.cle>   une clé dans une section INI             (lit + écrit)
#   toml:/chemin#<a.b.c>     une clé dans une table TOML              (lit + écrit)
#   regex:/chemin#<motif>    le groupe 1 d'un motif, tout format      (lit + écrit)
#   file:/chemin             le fichier entier comme valeur           (lit + écrit)
#   env:<service>#<VAR>      raccourci compose -> rendered/<svc>.env  (lit + écrit)
#   mysql:<user>@<conteneur> ALTER USER dans MariaDB/MySQL            (écrit)
#   cmd:<commande>           {value} = nouvelle valeur, {AUTRE} = autre secret
# Un mot de passe de compte Linux se fait avec cmd:, l'élévation restant ton choix :
#   cmd:sudo chpasswd <<< 'deploy:{value}'
# Les écritures sont chirurgicales : seule la valeur ciblée change, commentaires
# et mise en forme restent identiques.
#
# probe : commande de vérification pour `doctor`. Exit 0 = la valeur marche
# vraiment contre l'app. Doit être non destructive et n'afficher aucune valeur.
# validate : forme attendue de la valeur, refusée à l'entrée (`set`/`import`) et
# signalée par `check`. regex:<motif> | prefix:<s> | suffix:<s> | enum:a,b,c
# | len:<spec> | int[:<spec>] | url   (spec = >=N | <=N | >N | <N | N..M | N)


# --- Mot de passe applicatif poussé dans un .env de service -------------------
[APP_ADMIN_PASSWORD]
kind   = password
length = 24
group  = auto
sinks  =
    env:webapp#ADMIN_PASSWORD
note   = compte admin de l'application


# --- Utilisateur SQL : la valeur est appliquée dans la base ET dans l'env -----
[DB_APP_PASSWORD]
kind   = password
length = 24
group  = auto
sinks  =
    mysql:appuser@database
    env:database#MARIADB_PASSWORD
norestart =
    database
note   = norestart : la base ne lit cette variable qu'à l'initialisation ;
         le mot de passe réel est posé par le sink mysql:


# --- Secret dérivé : jamais stocké, recalculé à chaque lecture ----------------
[APP_DATABASE_URL]
kind    = computed
group   = manual
compute = raw mysql://appuser:{DB_APP_PASSWORD}@database:3306/appdb
sinks   =
    env:webapp#DATABASE_URL
note    = suit automatiquement DB_APP_PASSWORD


# --- Mot de passe root de la base : impactant, jamais roté par défaut ---------
[DB_ROOT_PASSWORD]
kind   = password
length = 32
group  = careful
sinks  =
    mysql:root@database
    env:database#MARIADB_ROOT_PASSWORD
norestart =
    database
note   = careful : roté uniquement s'il est explicitement ciblé


# --- Clé d'API d'une application tierce : JAMAIS générée ----------------------
# Un nom contenant API ou TOKEN impose kind=apikey. La valeur n'a de sens que si
# l'application la connaît : une chaîne aléatoire casserait le service. On la
# régénère dans l'app, puis `bv-secrets set MEDIA_API_KEY <valeur>`.
[MEDIA_API_KEY]
kind     = apikey
group    = manual
sinks    =
    env:dashboard#MEDIA_KEY
validate = prefix:mk_          # refuse une clé collée de travers dès `set`
note     = régénérer dans l'application, puis `set`


# --- Valeur imposée de l'extérieur, posée à la main ---------------------------
[APP_ADMIN_USER]
kind  = opaque
group = manual
sinks =
    env:dashboard#ADMIN_USER
note  = identifiant, pas un secret : opaque = jamais généré


# --- Application par commande + vérification réelle ---------------------------
[FILES_PASSWORD]
kind   = password
length = 20
group  = auto
sinks  =
    env:dashboard#FILES_PASSWORD
    cmd: docker compose run --rm files users update admin --password '{value}'
probe  = docker exec proxy wget -qO/dev/null --post-data='{"username":"admin","password":"{value}"}' http://files:80/api/login
note   = le sink cmd applique la valeur dans l'app, la probe confirme qu'elle marche


# --- Secret d'un fichier, hors docker ----------------------------------------
[SIGNING_KEY]
kind   = hex
length = 64
group  = app
sinks  =
    file:/etc/myapp/signing.key:0600
note   = app : roté seulement s'il est ciblé


# --- Adopter une valeur déjà en place dans un .env existant -------------------
# `bv-secrets import THIRDPARTY_ADMIN_PASSWORD` lit la valeur dans le fichier et
# la fait entrer dans le store, sans rien réécrire. Ensuite `status` la surveille.
[THIRDPARTY_ADMIN_PASSWORD]
kind  = password
group = app
sinks =
    envfile:/srv/thirdparty/.env#ADMIN_PASSWORD
note  = valeur préexistante adoptée via `import`


# --- Une valeur DANS un config structuré (json/yaml/ini/toml) ----------------
# Connecteur natif par chemin : seule la valeur change, le reste est préservé.
# `regex:` reste le passe-partout pour un format non couvert.
[GRAFANA_ADMIN_PASSWORD]
kind  = password
group = app
sinks =
    ini:/srv/grafana/grafana.ini#security.admin_password
note  = ini : atteint une clé de section sans toucher au reste du fichier
