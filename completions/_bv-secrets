#compdef bv-secrets
# Completion zsh pour bv-secrets.
#   deposer ce fichier dans un dossier de $fpath (ex: ~/.zsh/completions/_bv-secrets)
#   puis: autoload -Uz compinit && compinit
_bv_secrets() {
    local -a items
    items=( ${(f)"$(bv-secrets __complete $((CURRENT-1)) "${words[@]}" 2>/dev/null)"} )
    if (( ${#items} )); then
        compadd -- $items
    else
        _files                       # fallback fichiers (scan/adopt)
    fi
}
_bv_secrets "$@"
