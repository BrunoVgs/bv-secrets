# bv-secrets — configuration projet.
#
#   cp bv-secrets.ini.example bv-secrets.ini   puis edite les valeurs utiles.
#
# Un seul endroit pour tout regler. Chaque cle peut aussi etre imposee par une
# variable d'environnement (meme nom en MAJ, prefixe BV_) : env > fichier > defaut.
# Une machine nue sans ce fichier tourne sur les defauts.

[bv-secrets]

# Store : valeurs, renders, spool, miroir chiffre.       (BV_SECRETS_DIR)
secrets_dir = /opt/bv-secrets

# Definition des secrets.                                 (BV_SECRETS_CONF)
secrets_conf = secrets.conf

# Racine docker compose. Defaut : dossier parent du projet.   (BV_COMPOSE_DIR)
compose_dir = /srv/containers

# Repertoires depuis lesquels le dashboard peut adopter un fichier, separes par
# des virgules. Defaut : compose_dir seul. A elargir quand un deuxieme projet
# compose ou un .env hors de cette racine doit etre adopte.   (BV_ADOPT_ROOTS)
# Le worker tourne sous le compte qui possede la pile : sans cette liste il
# pourrait etre pointe sur n importe quel fichier lisible par ce compte.
adopt_roots = /srv/containers

# --- Proxy & acces ----------------------------------------------------------
# Reverse proxy qui consomme la matrice d'acces ; recree (pas restart) apres
# un changement car sa conf est montee fichier par fichier.   (BV_PROXY_SERVICE)
proxy_service = caddy
# Services a redemarrer apres un changement d'acces, separes par des virgules.
access_reload_services =
# Conteneur ou lire le log d'acces pour l'audit. Defaut : proxy_service.
caddy_container = caddy

# --- Roles ------------------------------------------------------------------
# Du plus fort au plus faible ; le premier est le superuser (passe toute porte).
roles = admin,trusted,guest

# --- Comptes ----------------------------------------------------------------
# Service hebergeant le CLI de comptes. Vide : la vue Comptes est desactivee.
auth_service =
# Prefixe console et sous-commandes. Defauts Symfony ; adapte a ton framework.
auth_console = php bin/console
auth_cmd_list = app:users
auth_cmd_setrole = app:set-role
auth_cmd_delete = app:delete-user

# --- Audit ------------------------------------------------------------------
# Prefixes de chemin a exclure de la timeline (polling interne, health checks).
audit_ignore_paths = /api/,/health
